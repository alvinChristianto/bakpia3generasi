<div
    class="fixed inset-0 bg-black bg-opacity-90 z-50 hidden"
    id="modal-overlay"
>
    <button
        class="absolute top-3 right-5 m-0 p-0 close-modal-button text-gray-300 hover:text-gray-700"
        >X</button
    >
</div>

<div
    class="fixed top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-white sm:max-w-sm w-64 lg:w-96 p-0 overflow-hidden rounded-lg shadow-lg z-50 hidden"
    id="modal-container"
>
    <img class="p-0 m-0 max-h-svh h-full" />
</div>

<script>
    import { isOpen } from "../store.js";

    function openDialog(ev: MouseEvent) {
        const target = ev.target;
        isOpen.set(true);
        const image = document.querySelector("#modal-container img");
        image?.setAttribute("src", target.src);
    }

    function closeDialog(ev: MouseEvent | FocusEvent) {
        isOpen.set(false);
    }

    const openButtons = document.getElementsByClassName("open-dialog");
    Array.prototype.forEach.call(openButtons, (element) => {
        element.addEventListener("click", openDialog);
    });

    const closeButtons = document.getElementsByClassName("close-modal-button");
    Array.prototype.forEach.call(closeButtons, (element) => {
        element.addEventListener("click", closeDialog);
    });

    isOpen.subscribe((open: boolean) => {
        const overlay = document.getElementById("modal-overlay");
        const container = document.getElementById("modal-container");
        if (open) {
            overlay?.classList.remove("hidden");
            container?.classList.remove("hidden");
        } else {
            overlay?.classList.add("hidden");
            container?.classList.add("hidden");
        }
    });

    const modal_overlay = document.getElementById("modal-overlay");
    modal_overlay?.addEventListener("click", closeDialog);
</script>
