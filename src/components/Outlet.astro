---
import data from "./../data/outlet.json";
---

<div class="mt-5">
    <h4>Outlet Bakpia</h4>
    <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
        {
            data.bakpia.map((outlet) => {
                return (
                    <div class="flex flex-col sm:mx-auto justify-between items-center bg-white border border-gray-200 rounded-lg shadow-sm md:flex-row md:max-w-xl hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:hover:bg-gray-700 dark:text-gray-100">
                        <img
                            class="open-dialog object-cover m-0 p-0 w-full rounded-t-lg h-80 md:h-auto md:w-60 md:rounded-none md:rounded-s-lg"
                            src={outlet.image}
                        />
                        <div class="card-content p-5 lg:ml-2 mr-2 mt-2 lg:mt-0">
                            <h6 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
                                {outlet.name}
                            </h6>
                            <div class="dark:text-gray-100">
                                WhatsApp:{" "}
                                <div class="md:inline">
                                    <a
                                        class="ml-5 md:ml-0 no-underline border-solid border-b border-b-red-500 dark:text-gray-100"
                                        href={`https://wa.me/${outlet.whatsapp}`}
                                    >
                                        +{outlet.whatsapp}
                                    </a>
                                </div>
                            </div>
                            <div>
                                Buka:{" "}
                                <div class="md:inline ml-5 md:ml-0">
                                    {outlet["open-at"]}
                                </div>
                            </div>
                            <iframe
                                class="w-full h-48"
                                src={outlet.maps}
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="no-referrer-when-downgrade"
                            />
                        </div>
                    </div>
                );
            })
        }
    </div>
</div>

